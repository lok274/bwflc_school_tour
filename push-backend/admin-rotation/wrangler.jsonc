{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bwflc-school-tour-admin-key",
  "main": "worker.js",
  "compatibility_date": "2026-06-25",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ADMIN_ROTATION", "class_name": "AdminRotation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdminRotation"] }],
  "services": [{ "binding": "PUSH_BACKEND", "service": "bwflc-school-tour-push" }],
  "vars": { "ROTATION_ENABLED": "false" },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}
