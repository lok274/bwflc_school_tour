{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bwflc-school-tour-push",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "PUSH_SERVICE", "class_name": "PushService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushService"] }],
  "vars": {
    "APP_ORIGIN": "https://lok274.github.io",
    "APP_URL": "https://lok274.github.io/bwflc_school_tour/",
    "VAPID_SUBJECT": "https://github.com/lok274/bwflc_school_tour"
  },
  "observability": { "enabled": false }
}
